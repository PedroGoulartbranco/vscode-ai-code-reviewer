{
  "name": "vscode-ai-code-reviewer",
  "displayName": "ai-code-reviewer",
  "description": "An AI-powered code reviewer that identifies bugs and suggests optimizations.",
  "icon": "icon_ia.png",
  "publisher": "PedroGoulartbranco",
  "version": "1.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/PedroGoulartbranco/vscode-ai-code-reviewer"
  },
  "engines": {
    "vscode": "^1.115.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ai-code-reviewer",
        "title": "Ai Reviewer Code"
      }
    ],
    "configuration": {
      "title": "AI Code Reviewer Configuration",
      "properties": {
        "aiReviewer.apiKey": {
          "type": "string",
          "default": "",
          "description": "Enter your Gemini API Key to enable code review features."
        },
        "aiReviewer.language": {
          "type": "string",
          "default": "English",
          "enum": ["English", "Portuguese (Brazilian)"],
          "description": "Language of the reports generated by the AI."
        },
        "aiReviewer.model": {
          "type": "string",
          "default": "gemini-2.5-flash-lite",
          "enum": ["gemini-2.5-flash-lite", "gemini-2.5-flash", "gemini-2.5-pro", "gemini-2.0-flash"],
          "description": "Select the Gemini model to use for code analysis. Flash models are faster, while Pro models provide deeper reasoning.",
          "enumDescriptions": [
            "Fastest and lightest model for simple reviews.",
            "Balanced model for daily development.",
            "Highest intelligence for complex debugging and security.",
            "Fast model using the 2.0 architecture."
          ]
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.115.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1"
  }
}
